{
    "name": "quire/testing",
    "type": "library",
    "description": "Test Quire extensions and themes: a minimal test application, a PHPUnit base class and helpers.",
    "keywords": ["quire", "cms", "testing", "phpunit"],
    "homepage": "https://quirecms.com",
    "license": "MIT",
    "authors": [
        {
            "name": "YorvoLabs",
            "homepage": "https://quirecms.com"
        }
    ],
    "support": {
        "email": "hello@quirecms.com",
        "issues": "https://github.com/quirecms/framework/issues",
        "security": "https://github.com/quirecms/framework/security/policy"
    },
    "require": {
        "php": ">=8.5",
        "doctrine/doctrine-bundle": "^3.0",
        "phpunit/phpunit": "^13.4",
        "quire/core": "^0.2",
        "symfony/browser-kit": "^8.1",
        "symfony/css-selector": "^8.1",
        "symfony/filesystem": "^8.1",
        "symfony/framework-bundle": "^8.1",
        "symfony/security-bundle": "^8.1",
        "symfony/twig-bundle": "^8.1"
    },
    "autoload": {
        "psr-4": {
            "Quire\\Testing\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Quire\\Testing\\Tests\\": "tests/"
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true,
    "extra": {
        "branch-alias": {
            "dev-main": "0.2.x-dev"
        }
    }
}
